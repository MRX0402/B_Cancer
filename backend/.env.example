# Copy this file to .env and adjust values

# Database (defaults to local SQLite file if unset)
DATABASE_URL=sqlite:///./bcancer.db

# JWT
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS - comma separated list of allowed origins ("*" for any, dev only)
CORS_ORIGINS=*

# Optional: AI chat provider key (used by /api/chat). Leave empty to use the
# built-in mock responder so the endpoint still works without a key.
ANTHROPIC_API_KEY=
